# ===================== AI 模型配置 =====================
# 从 https://platform.deepseek.com/api_keys 获取，禁止提交真实 Key
# 兼容旧配置：AI_* 与 DEEPSEEK_* 均可；新部署推荐 DEEPSEEK_*。
AI_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# DeepSeek 官方 OpenAI 兼容接口地址
AI_BASE_URL=https://api.deepseek.com

# 当前 DeepSeek 官方支持图片输入的视觉模型
AI_MODEL=deepseek-flash

# 服务商标识：deepseek / openai / gemini / openai_compatible
AI_PROVIDER=deepseek

# 单次模型请求超时（秒）
AI_TIMEOUT=180

# 失败重试次数（0 表示不重试）
AI_MAX_RETRIES=2

# 重试退避基数（秒），实际等待按指数增长
AI_RETRY_BACKOFF=0.8

# 图片细节级别：low / high / original / auto，建议 high
AI_VISION_DETAIL=high

# 是否启用 DeepSeek 思考模式（提高准确率，但增加耗时和费用）
AI_ENABLE_THINKING=true
AI_REASONING_EFFORT=high

# 模型最大输出 token，多人图片建议保持较大值
AI_MAX_OUTPUT_TOKENS=16384

# 可选：显式声明模型是否支持图片输入；留空则由 Provider 自动判断
# AI_MODEL_SUPPORTS_VISION=true

# 可选：本地 DNS 解析到的节点无法连接时，直连指定 IP。
# TLS 证书与 Host 头仍使用 AI_BASE_URL 中的域名，不会降低安全性。
# 例如通过 `dig @180.76.76.76 api.deepseek.com +short` 查找可用节点。
# AI_CONNECT_IP=

# ===================== 图片上传配置 =====================
MAX_UPLOAD_SIZE_MB=10
IMAGE_MAX_DIMENSION=2048
IMAGE_MAX_PIXELS=40000000

# ===================== 其它 =====================
APP_DEBUG=false
CORS_ORIGINS=

# 二期局部裁剪分析开关（当前版本仅预留接口）
ENABLE_CROP_REFINEMENT=false

# ===================== 本地存储与生命周期 =====================
STORAGE_ROOT=./storage
PROMPTS_DIR=./prompts
# 图片分析结果默认保留在内存；Phase 2 接入 Mask 后会改为受控持久化
PERSIST_ANALYSIS=false
ANALYSIS_RETENTION_HOURS=24
VIDEO_RETENTION_HOURS=24
FRAME_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30
MASK_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=3600

# ===================== 视频处理（Phase 3） =====================
# 留空时优先使用 runtime/bin/ffmpeg，其次使用系统 PATH
FFMPEG_BINARY=
FFPROBE_BINARY=
VIDEO_MAX_UPLOAD_SIZE_MB=100
VIDEO_MAX_DURATION_SECONDS=20
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_SAMPLE_FPS=2
VIDEO_MAX_CANDIDATE_FRAMES=60
VIDEO_KEYFRAME_COUNT=8
VIDEO_MAX_AI_CALLS=12
VIDEO_MAX_CONCURRENT_TASKS=1
VIDEO_FRAME_MAX_SIDE=1280
VIDEO_FRAME_JPEG_QUALITY=85

# ===================== 本地帧筛选（Phase 3） =====================
FRAME_MIN_SHARPNESS=50
FRAME_MIN_BRIGHTNESS=25
FRAME_MAX_BRIGHTNESS=235
FRAME_DEDUP_HAMMING=6
FRAME_PROBE_COUNT=4

# ===================== Worker（Phase 3） =====================
VIDEO_WORKER_ENABLED=true
WORKER_LEASE_SECONDS=60
WORKER_TASK_TIMEOUT_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_MAX_ATTEMPTS=2

# ===================== Mask（Phase 4） =====================
# bbox：明确标记为粗略矩形 Mask；none：返回能力不可用
MASK_PROVIDER=bbox

# ===================== 单图分析预算 =====================
AI_MAX_CALLS_PER_ANALYSIS=5
AI_MAX_CONCURRENT_REQUESTS=2
ANALYSIS_CROP_PADDING_RATIO=0.15
ANALYSIS_CROP_MIN_SIDE=512
ANALYSIS_CROP_MAX_SIDE=1536
