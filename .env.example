# ===================== AI 模型配置 =====================
# 从 https://platform.deepseek.com/api_keys 获取，禁止提交真实 Key
AI_API_KEY=sk-your-deepseek-api-key

# DeepSeek 官方 OpenAI 兼容接口地址
AI_BASE_URL=https://api.deepseek.com

# 当前 DeepSeek 官方支持图片输入的视觉模型
AI_MODEL=deepseek-flash

# 服务商标识：deepseek / openai / gemini / openai_compatible
AI_PROVIDER=deepseek

# 单次模型请求超时（秒）
AI_TIMEOUT=180

# 失败重试次数（0 表示不重试）
AI_MAX_RETRIES=2

# 重试退避基数（秒），实际等待按指数增长
AI_RETRY_BACKOFF=0.8

# 图片细节级别：low / high / original / auto，建议 high
AI_VISION_DETAIL=high

# 是否启用 DeepSeek 思考模式（提高准确率，但增加耗时和费用）
AI_ENABLE_THINKING=true
AI_REASONING_EFFORT=high

# 模型最大输出 token，多人图片建议保持较大值
AI_MAX_OUTPUT_TOKENS=16384

# 可选：显式声明模型是否支持图片输入；留空则由 Provider 自动判断
# AI_MODEL_SUPPORTS_VISION=true

# 可选：本地 DNS 解析到的节点无法连接时，直连指定 IP。
# TLS 证书与 Host 头仍使用 AI_BASE_URL 中的域名，不会降低安全性。
# 例如通过 `dig @180.76.76.76 api.deepseek.com +short` 查找可用节点。
# AI_CONNECT_IP=

# ===================== 图片上传配置 =====================
MAX_UPLOAD_SIZE_MB=10
IMAGE_MAX_DIMENSION=2048
IMAGE_MAX_PIXELS=40000000

# ===================== 其它 =====================
APP_DEBUG=false
CORS_ORIGINS=

# 二期局部裁剪分析开关（当前版本仅预留接口）
ENABLE_CROP_REFINEMENT=false

# ===================== 人像局部编辑 =====================
# 阿里云百炼万相（华北2 北京地域 API Key）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# 旧版通用域名；也可使用业务空间专属域名并通过 DASHSCOPE_WORKSPACE_ID 自动拼接
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WORKSPACE_ID=
IMAGE_EDIT_MODEL=wanx2.1-imageedit
IMAGE_EDIT_PROVIDER=wanx
IMAGE_EDIT_TIMEOUT=600
IMAGE_EDIT_MAX_RETRIES=2
IMAGE_EDIT_POLL_INITIAL=3
IMAGE_EDIT_POLL_MAX=10
IMAGE_EDIT_WATERMARK=false
EDIT_MAX_REGIONS_PER_GENERATION=5
EDIT_PROMPT_MAX_LENGTH=800

# ===================== 本地存储 =====================
STORAGE_ROOT=./storage
STORAGE_TTL_HOURS=24

# ===================== SAM2 分割 =====================
# sam2 / mock / bbox；mock 仅用于测试，bbox 仅用于开发降级
SEGMENTATION_PROVIDER=sam2
SEGMENTATION_DEVICE=auto
SEGMENTATION_MODEL_CFG=configs/sam2.1/sam2.1_hiera_s.yaml
SEGMENTATION_CHECKPOINT=./models/sam2.1_hiera_small.pt
SEGMENTATION_MIN_SCORE=0.05
EDIT_MAX_PERSONS=10
EDIT_MIN_PROVIDER_DIMENSION=512
EDIT_MAX_PROVIDER_DIMENSION=2048
# IMAGE_EDIT_SEED=
